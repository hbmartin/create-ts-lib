{
  "name": "@hbmartin/create-ts-lib",
  "version": "1.0.0",
  "description": "Opinionated TypeScript library scaffolder.",
  "type": "module",
  "bin": {
    "create-ts-lib": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit"
  },
  "keywords": [
    "create",
    "scaffold",
    "typescript",
    "library"
  ],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.32.1",
  "dependencies": {
    "@inquirer/prompts": "^7.8.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.7",
    "@types/node": "^25.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
