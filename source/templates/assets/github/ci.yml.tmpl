name: ci
on:
  pull_request:
    branches: [main]
  push:
    branches: [main]

permissions:
  contents: read
  pull-requests: write

concurrency:
  group: ci-${{ github.ref }}
  cancel-in-progress: true

jobs:
  checks:
    runs-on: ubuntu-latest
    strategy:
      fail-fast: false
      matrix:
        node-version: ["24"]
    steps:
      - uses: {{ACTION_CHECKOUT}}
        with:
          persist-credentials: false
{{PACKAGE_MANAGER_SETUP}}
      - uses: {{ACTION_SETUP_NODE}}
        with:
          node-version: ${{ matrix.node-version }}
          cache: "{{CACHE}}"
      - uses: {{ACTION_SETUP_UV}}
        with:
          enable-cache: true
      - run: {{INSTALL_CI_COMMAND}}
      - run: {{AUDIT_COMMAND}}
      - run: {{RUN_PREFIX}} check
        env:
          SECURITY_LINT_FORCE_UVX: "1"
      - run: {{BUILD_COMMAND}}
      - run: {{PUBLINT_COMMAND}}
{{CODECOV_STEP}}
