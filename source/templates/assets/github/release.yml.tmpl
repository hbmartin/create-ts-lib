name: Release

on:
  release:
    types: [published]

permissions:
  contents: read
  id-token: write

concurrency:
  group: release-${{ github.event.release.tag_name }}
  cancel-in-progress: false

jobs:
  publish:
    name: Publish to npm
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: {{ACTION_CHECKOUT}}
        with:
          ref: ${{ github.event.release.tag_name }}

      - name: Setup pnpm
        uses: {{ACTION_PNPM_SETUP}}
        with:
          version: {{PNPM_VERSION}}

      - name: Setup Node.js
        uses: {{ACTION_SETUP_NODE}}
        with:
          node-version: '{{NODE_TARGET}}.x'
          cache: 'pnpm'
          cache-dependency-path: pnpm-lock.yaml
          registry-url: 'https://registry.npmjs.org'

      - name: Setup uv
        uses: {{ACTION_SETUP_UV}}
        with:
          enable-cache: true

      - name: Upgrade npm to latest
        run: |
          npm -v
          npm config set prefix ~/.local
          export PATH="$HOME/.local/bin:$PATH"
          echo "$HOME/.local/bin" >> "$GITHUB_PATH"
          npm install -g npm@latest
          hash -r
          npm -v

      - name: Install dependencies
        run: pnpm install --frozen-lockfile

      - name: Run release checks
        run: pnpm run release:check
        env:
          SECURITY_LINT_FORCE_UVX: "1"

      - name: Report bundle size
        run: pnpm run size:report

      - name: Publish to npm
        run: |
          TAG="latest"
          if [[ "${{ github.event.release.prerelease }}" == "true" ]]; then
            TAG="next"
          fi

          echo "Publishing with tag: $TAG"
          npm publish --tag "$TAG" --access public --provenance{{JSR_PUBLISH_STEP}}
