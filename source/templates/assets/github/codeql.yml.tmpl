name: codeql

on:
  pull_request:
    branches: [main]
  push:
    branches: [main]
  schedule:
    - cron: "29 3 * * 1"

permissions:
  contents: read

jobs:
  analyze:
    runs-on: ubuntu-latest
    permissions:
      contents: read
      security-events: write
    steps:
      - uses: {{ACTION_CHECKOUT}}
        with:
          persist-credentials: false
      - uses: {{ACTION_CODEQL_INIT}}
        with:
          languages: javascript-typescript
      - uses: {{ACTION_CODEQL_ANALYZE}}
