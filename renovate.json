{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "rangeStrategy": "bump",
  "packageRules": [
    {
      "description": "Keep GitHub Actions pinned and updated deliberately.",
      "matchManagers": ["github-actions"],
      "pinDigests": true
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track quoted npm dependencies embedded in generated package.json templates.",
      "managerFilePatterns": [
        "/^source/templates/files\\.ts$/",
        "/^source/templates/generated-versions\\.ts$/"
      ],
      "matchStrings": [
        "\"(?<depName>(?:@[^/]+/)?[^\"\\s]+)\":\\s*\"\\^(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "npm",
      "versioningTemplate": "npm"
    },
    {
      "customType": "regex",
      "description": "Track the template-only meow dependency emitted into generated package.json files.",
      "managerFilePatterns": ["/^source/templates/generated-versions\\.ts$/"],
      "matchStrings": ["meow:\\s*\"\\^(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "meow",
      "datasourceTemplate": "npm",
      "versioningTemplate": "npm"
    },
    {
      "customType": "regex",
      "description": "Track pinned TypeScript native-preview probes in CI workflows.",
      "managerFilePatterns": [
        "/^\\.github/workflows/ci\\.yml$/",
        "/^source/templates/files\\.ts$/"
      ],
      "matchStrings": [
        "@typescript/native-preview@(?<currentValue>[^\\s]+)\\s+dlx\\s+tsgo"
      ],
      "depNameTemplate": "@typescript/native-preview",
      "datasourceTemplate": "npm",
      "versioningTemplate": "npm"
    }
  ]
}
