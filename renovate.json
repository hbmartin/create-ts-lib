{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "rangeStrategy": "bump",
  "packageRules": [
    {
      "description": "Keep GitHub Actions pinned and updated deliberately.",
      "matchManagers": ["github-actions"],
      "pinDigests": true
    },
    {
      "description": "Generated projects target Node 22/24, so the @types/node they receive stays on the 24.x line. This scopes only the template pin; the generator's own @types/node in package.json still tracks latest.",
      "matchFileNames": ["source/templates/generated-versions.ts"],
      "matchPackageNames": ["@types/node"],
      "allowedVersions": "<25"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track quoted npm dependencies embedded in generated package.json templates.",
      "managerFilePatterns": [
        "/^source/templates/files\\.ts$/",
        "/^source/templates/generated-versions\\.ts$/"
      ],
      "matchStrings": [
        "\"(?<depName>(?:@[^/]+/)?[^\"\\s]+)\":\\s*\"\\^(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "npm",
      "versioningTemplate": "npm"
    },
    {
      "customType": "regex",
      "description": "Track the template-only meow dependency emitted into generated package.json files.",
      "managerFilePatterns": ["/^source/templates/generated-versions\\.ts$/"],
      "matchStrings": ["meow:\\s*\"\\^(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "meow",
      "datasourceTemplate": "npm",
      "versioningTemplate": "npm"
    },
    {
      "customType": "regex",
      "description": "Track the template-only jsr dependency emitted into generated package.json files.",
      "managerFilePatterns": ["/^source/templates/generated-versions\\.ts$/"],
      "matchStrings": ["jsr:\\s*\"\\^(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "jsr",
      "datasourceTemplate": "npm",
      "versioningTemplate": "npm"
    },
    {
      "customType": "regex",
      "description": "Track the template-only tsdown dependency emitted into generated package.json files.",
      "managerFilePatterns": ["/^source/templates/generated-versions\\.ts$/"],
      "matchStrings": ["tsdown:\\s*\"\\^(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "tsdown",
      "datasourceTemplate": "npm",
      "versioningTemplate": "npm"
    },
    {
      "customType": "regex",
      "description": "Track SHA-pinned GitHub Actions emitted into generated workflows. The github-actions manager only reads workflow YAML, so without this the copies in githubActionRefs drift and scaffolded projects stay pinned to stale actions.",
      "managerFilePatterns": ["/^source/templates/generated-versions\\.ts$/"],
      "matchStrings": [
        "\"(?<depName>[^\"\\s@/]+/[^\"\\s@/]+)(?:/[^\"\\s@]*)?@(?<currentDigest>[0-9a-f]{40})\\s*#\\s*(?<currentValue>v[^\"\\s]+)\""
      ],
      "datasourceTemplate": "github-tags"
    },
    {
      "customType": "regex",
      "description": "Track the pinned Semgrep version used by the security lint wrapper and its generated copy.",
      "managerFilePatterns": [
        "/^source/templates/generated-versions\\.ts$/",
        "/^scripts/security-lint\\.mjs$/"
      ],
      "matchStrings": ["semgrepVersion = \"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "semgrep",
      "datasourceTemplate": "pypi",
      "versioningTemplate": "pep440"
    }
  ]
}
