#!/usr/bin/env node
import meow from "meow";

meow(
  `
  Usage
    $ biome-library <input>

  Options
    --help     Show help
    --version  Show version
  `,
  { importMeta: import.meta },
);

===== test/cli.test.ts =====
executable: false

import { describe, expect, it, vi } from "vitest";

const { meow } = vi.hoisted(() => ({
  meow: vi.fn(() => ({
    flags: {},
    input: [],
  })),
}));

vi.mock("meow", () => ({
  default: meow,
}));

describe("cli", () => {
  it("configures the CLI help text", async () => {
    await import("../source/cli.js");

    expect(meow).toHaveBeenCalledWith(
      expect.stringContaining("$ biome-library <input>"),
      expect.objectContaining({
        importMeta: expect.anything(),
      }),
    );
  });
});

