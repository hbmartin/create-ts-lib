===== semgrep.yml =====
executable: false

rules:
  - id: no-eval-like-execution
    message: Avoid eval-like dynamic code execution. Parse data or dispatch explicit functions instead.
    severity: ERROR
    languages:
      - javascript
      - typescript
    pattern-either:
      - pattern: eval(...)
      - pattern: new Function(...)

  - id: no-child-process-exec
    message: Avoid child_process exec/execSync. Use execFile or spawn with explicit arguments instead.
    severity: ERROR
    languages:
      - javascript
      - typescript
    pattern-either:
      - patterns:
          - pattern-inside: |
              import * as $CHILD_PROCESS from "node:child_process";
              ...
          - pattern-either:
              - pattern: $CHILD_PROCESS.exec(...)
              - pattern: $CHILD_PROCESS.execSync(...)
      - patterns:
          - pattern-inside: |
              import * as $CHILD_PROCESS from "child_process";
              ...
          - pattern-either:
              - pattern: $CHILD_PROCESS.exec(...)
              - pattern: $CHILD_PROCESS.execSync(...)
      - patterns:
          - pattern-inside: |
              import $CHILD_PROCESS from "node:child_process";
              ...
          - pattern-either:
              - pattern: $CHILD_PROCESS.exec(...)
              - pattern: $CHILD_PROCESS.execSync(...)
      - patterns:
          - pattern-inside: |
              import $CHILD_PROCESS from "child_process";
              ...
          - pattern-either:
              - pattern: $CHILD_PROCESS.exec(...)
              - pattern: $CHILD_PROCESS.execSync(...)
      - patterns:
          - pattern-inside: |
              const $CHILD_PROCESS = require("node:child_process");
              ...
          - pattern-either:
              - pattern: $CHILD_PROCESS.exec(...)
              - pattern: $CHILD_PROCESS.execSync(...)
      - patterns:
          - pattern-inside: |
              const $CHILD_PROCESS = require("child_process");
              ...
          - pattern-either:
              - pattern: $CHILD_PROCESS.exec(...)
              - pattern: $CHILD_PROCESS.execSync(...)
      - patterns:
          - pattern-inside: |
              import { exec } from "node:child_process";
              ...
          - pattern: exec(...)
      - patterns:
          - pattern-inside: |
              import { exec } from "child_process";
              ...
          - pattern: exec(...)
      - patterns:
          - pattern-inside: |
              import { execSync } from "node:child_process";
              ...
          - pattern: execSync(...)
      - patterns:
          - pattern-inside: |
              import { execSync } from "child_process";
              ...
          - pattern: execSync(...)
      - patterns:
          - pattern-inside: |
              import { exec as $EXEC } from "node:child_process";
              ...
          - pattern: $EXEC(...)
      - patterns:
          - pattern-inside: |
              import { exec as $EXEC } from "child_process";
              ...
          - pattern: $EXEC(...)
      - patterns:
          - pattern-inside: |
              import { execSync as $EXEC_SYNC } from "node:child_process";
              ...
          - pattern: $EXEC_SYNC(...)
      - patterns:
          - pattern-inside: |
              import { execSync as $EXEC_SYNC } from "child_process";
              ...
          - pattern: $EXEC_SYNC(...)
      - patterns:
          - pattern-inside: |
              const { exec } = require("node:child_process");
              ...
          - pattern: exec(...)
      - patterns:
          - pattern-inside: |
              const { exec } = require("child_process");
              ...
          - pattern: exec(...)
      - patterns:
          - pattern-inside: |
              const { execSync } = require("node:child_process");
              ...
          - pattern: execSync(...)
      - patterns:
          - pattern-inside: |
              const { execSync } = require("child_process");
              ...
          - pattern: execSync(...)
      - patterns:
          - pattern-inside: |
              const { exec: $EXEC } = require("node:child_process");
              ...
          - pattern: $EXEC(...)
      - patterns:
          - pattern-inside: |
              const { exec: $EXEC } = require("child_process");
              ...
          - pattern: $EXEC(...)
      - patterns:
          - pattern-inside: |
              const { execSync: $EXEC_SYNC } = require("node:child_process");
              ...
          - pattern: $EXEC_SYNC(...)
      - patterns:
          - pattern-inside: |
              const { execSync: $EXEC_SYNC } = require("child_process");
              ...
          - pattern: $EXEC_SYNC(...)

  - id: no-shell-true-process
    message: Avoid shell:true process execution. Pass explicit argv to the executable instead.
    severity: ERROR
    languages:
      - javascript
      - typescript
    pattern-either:
      - pattern: 'spawn($COMMAND, $ARGS, { ..., shell: true, ... })'
      - pattern: 'spawnSync($COMMAND, $ARGS, { ..., shell: true, ... })'
      - pattern: 'execa($COMMAND, $ARGS, { ..., shell: true, ... })'
      - patterns:
          - pattern: '$PROCESS($COMMAND, { ..., shell: true, ... })'
          - metavariable-regex:
              metavariable: $PROCESS
              regex: ^(spawn|spawnSync|execFile|execFileSync|execa|execaSync|execaCommand|execaCommandSync)$

  - id: no-weak-crypto-hash
    message: Avoid weak cryptographic hashes. Use SHA-256 or stronger for security-sensitive hashing.
    severity: ERROR
    languages:
      - javascript
      - typescript
    pattern-either:
      - pattern: crypto.createHash("md5")
      - pattern: crypto.createHash("sha1")
      - pattern: createHash("md5")
      - pattern: createHash("sha1")

  - id: no-math-random-security-sensitive
    message: Avoid Math.random for security-sensitive values. Use crypto.randomUUID or crypto.getRandomValues instead.
    severity: ERROR
    languages:
      - javascript
      - typescript
    pattern-either:
      - patterns:
          - pattern-either:
              - pattern: const $NAME = Math.random()
              - pattern: let $NAME = Math.random()
              - pattern: var $NAME = Math.random()
              - pattern: $OBJECT.$NAME = Math.random()
          - metavariable-regex:
              metavariable: $NAME
              regex: (?i)(token|secret|nonce|session|password|key|csrf|auth)
      - patterns:
          - pattern-either:
              - pattern: |
                  function $NAME(...) {
                    ...
                    return Math.random()
                    ...
                  }
              - pattern: const $NAME = (...) => Math.random()
              - pattern: |
                  const $NAME = (...) => {
                    ...
                    return Math.random()
                    ...
                  }
          - metavariable-regex:
              metavariable: $NAME
              regex: (?i)(token|secret|nonce|session|password|key|csrf|auth)

===== scripts/security-lint.mjs =====
executable: false

import { spawnSync } from "node:child_process";

const semgrepVersion = "1.165.0";
const semgrepArguments = ["scan", "--config", "semgrep.yml", "--error", "source", "test"];
const forceUvx = process.env.SECURITY_LINT_FORCE_UVX === "1";

const runCommand = (command, arguments_) =>
  spawnSync(command, arguments_, {
    stdio: "inherit",
  });

const warn = (message) => {
  process.stderr.write(`${message}\n`);
};

const exitWithResult = (result) => {
  if (result.error) {
    throw result.error;
  }

  if (result.signal) {
    warn(`warning: security lint exited after signal ${result.signal}`);
    process.exit(1);
  }

  process.exit(result.status ?? 1);
};

const runSemgrep = () => {
  if (forceUvx) {
    return { error: Object.assign(new Error("Forced uvx Semgrep"), { code: "ENOENT" }) };
  }

  return runCommand("semgrep", semgrepArguments);
};

const runPinnedSemgrep = () =>
  runCommand("uvx", [`semgrep@${semgrepVersion}`, ...semgrepArguments]);

const semgrepResult = runSemgrep();

if (!semgrepResult.error) {
  exitWithResult(semgrepResult);
}

if (semgrepResult.error.code !== "ENOENT") {
  throw semgrepResult.error;
}

const uvxResult = runPinnedSemgrep();

if (uvxResult.error?.code === "ENOENT") {
  warn(`warning: security:lint requires semgrep on PATH or uvx for semgrep@${semgrepVersion}.`);
  warn("warning: install Semgrep directly or install uv so uvx can run the pinned scan.");
  process.exit(1);
}

exitWithResult(uvxResult);

